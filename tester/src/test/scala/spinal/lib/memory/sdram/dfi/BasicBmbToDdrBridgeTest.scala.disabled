package spinal.lib.memory.sdram.dfi

import spinal.core._
import spinal.lib._
import spinal.lib.bus.bmb.{BmbParameter, Bmb}
import spinal.tester.code.SpinalAnyFunSuite
import spinal.core.sim._

/**
 * 基本的BmbToDdrBridge测试，不依赖复杂的PHY
 */
class BasicBmbToDdrBridgeTest extends SpinalAnyFunSuite {

  test("BmbToDdrBridge basic instantiation") {
    // 配置BMB参数为64位数据宽度
    val accessConfig = spinal.lib.bus.bmb.BmbAccessParameter(
      addressWidth = 32,
      dataWidth = 64
    )
    val bmbParameter = BmbParameter(accessConfig)

    // 创建最小化的SDRAM配置
    val minimalSdramConfig = SdramConfig(
      generation = SdramGeneration.DDR3,
      bgWidth = 0,
      cidWidth = 0,
      bankWidth = 3,
      columnWidth = 10,
      rowWidth = 16,
      dataWidth = 32,
      ddrMHZ = 400,
      ddrWrLat = 11,
      ddrRdLat = 11,
      sdramtime = SdramTiming(
        generation = 3,
        RFC = 160,
        RAS = 35,
        RP = 35,
        RCD = 14,
        WTR = 8,
        WTP = 15,
        RTP = 8,
        RRD = 6,
        REF = 64,
        FAW = 40
      )
    )

    // 使用最小的DFI信号配置
    val minimalDfiFunctionConfig = DfiFunctionConfig(
      useCtrlSignals = true,
      useWrDataSignals = true,
      useRdDataSignals = true,
      useUpdateSignals = false,
      useStatusSignals = false,
      useTrainingSignals = false,
      useLowPowerSignals = false,
      useErrorSignals = false
    )

    val ddr3Config = DfiConfig(
      chipSelectNumber = 1,
      dataSlice = 4,
      signalConfig = DfiSignalConfig.DDR3(minimalDfiFunctionConfig, useCrc = false),
      timeConfig = DfiTimeConfig(
        frequencyRatio = 1,
        cmdPhase = 0,
        tPhyWrLat = 9,
        tPhyWrData = 1,
        tPhyWrCsLat = 0,
        tPhyWrCsGap = 0,
        tRddataEn = 9,
        tPhyRdlat = 9,
        tPhyRdCslat = 0,
        tPhyRdCsGap = 0
      ),
      sdram = minimalSdramConfig
    )

    println("正在测试BmbToDdrBridge基本实例化...")

    try {
      // 仅测试组件能够实例化，不进行仿真
      SpinalConfig(mode = Verilog, targetDirectory = "/tmp").generate {
        new BmbToDdrBridge(bmbParameter, ddr3Config) {
          // 重写PHY实例化以避免XilinxUSPhy的问题
          override val xilinxPhy = null // 不实例化PHY
        }
      }
      println("✓ BmbToDdrBridge基本实例化成功")
    } catch {
      case e: Exception =>
        println(s"! 实例化失败: ${e.getMessage}")
        throw e
    }
  }

  test("BmbToDdrBridge DDR3 and DDR4 configuration compilation") {
    val accessConfig = spinal.lib.bus.bmb.BmbAccessParameter(
      addressWidth = 32,
      dataWidth = 64
    )
    val bmbParameter = BmbParameter(accessConfig)

    val minimalDfiFunctionConfig = DfiFunctionConfig(
      useCtrlSignals = true,
      useWrDataSignals = true,
      useRdDataSignals = true,
      useUpdateSignals = false,
      useStatusSignals = false,
      useTrainingSignals = false,
      useLowPowerSignals = false,
      useErrorSignals = false
    )

    // 测试DDR3配置编译
    val ddr3SdramConfig = SdramConfig(
      generation = SdramGeneration.DDR3,
      bgWidth = 0,
      cidWidth = 0,
      bankWidth = 3,
      columnWidth = 10,
      rowWidth = 16,
      dataWidth = 32,
      ddrMHZ = 400,
      ddrWrLat = 11,
      ddrRdLat = 11,
      sdramtime = SdramTiming(
        generation = 3,
        RFC = 160,
        RAS = 35,
        RP = 35,
        RCD = 14,
        WTR = 8,
        WTP = 15,
        RTP = 8,
        RRD = 6,
        REF = 64,
        FAW = 40
      )
    )

    val ddr3Config = DfiConfig(
      chipSelectNumber = 1,
      dataSlice = 4,
      signalConfig = DfiSignalConfig.DDR3(minimalDfiFunctionConfig, useCrc = false),
      timeConfig = DfiTimeConfig(
        frequencyRatio = 1,
        cmdPhase = 0,
        tPhyWrLat = 9,
        tPhyWrData = 1,
        tPhyWrCsLat = 0,
        tPhyWrCsGap = 0,
        tRddataEn = 9,
        tPhyRdlat = 9,
        tPhyRdCslat = 0,
        tPhyRdCsGap = 0
      ),
      sdram = ddr3SdramConfig
    )

    // 测试DDR4配置编译
    val ddr4SdramConfig = SdramConfig(
      generation = SdramGeneration.DDR4,
      bgWidth = 2,
      cidWidth = 0,
      bankWidth = 2,
      columnWidth = 10,
      rowWidth = 17,
      dataWidth = 32,
      ddrMHZ = 800,
      ddrWrLat = 12,
      ddrRdLat = 12,
      sdramtime = SdramTiming(
        generation = 4,
        RFC = 295,
        RAS = 35,
        RP = 35,
        RCD = 14,
        WTR = 8,
        WTP = 15,
        RTP = 8,
        RRD = 6,
        REF = 64,
        FAW = 30
      )
    )

    val ddr4Config = DfiConfig(
      chipSelectNumber = 1,
      dataSlice = 4,
      signalConfig = DfiSignalConfig.DDR4(minimalDfiFunctionConfig, useCrc = false),
      timeConfig = DfiTimeConfig(
        frequencyRatio = 1,
        cmdPhase = 0,
        tPhyWrLat = 10,
        tPhyWrData = 1,
        tPhyWrCsLat = 0,
        tPhyWrCsGap = 0,
        tRddataEn = 10,
        tPhyRdlat = 10,
        tPhyRdCslat = 0,
        tPhyRdCsGap = 0
      ),
      sdram = ddr4SdramConfig
    )

    println("正在测试DDR3配置编译...")
    try {
      SpinalConfig(mode = Verilog, targetDirectory = "/tmp").generate {
        new BmbToDdrBridge(bmbParameter, ddr3Config) {
          override val xilinxPhy = null
        }
      }
      println("✓ DDR3配置编译成功")
    } catch {
      case e: Exception =>
        println(s"! DDR3配置编译失败: ${e.getMessage}")
        throw e
    }

    println("正在测试DDR4配置编译...")
    try {
      SpinalConfig(mode = Verilog, targetDirectory = "/tmp").generate {
        new BmbToDdrBridge(bmbParameter, ddr4Config) {
          override val xilinxPhy = null
        }
      }
      println("✓ DDR4配置编译成功")
    } catch {
      case e: Exception =>
        println(s"! DDR4配置编译失败: ${e.getMessage}")
        throw e
    }

    println("✓ 所有配置测试完成")
  }
}